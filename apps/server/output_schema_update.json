{
  "stack": {
    "language": "TypeScript",
    "frontendFramework": "React",
    "buildTool": "Vite",
    "packageManager": "pnpm"
  },
  "strategies": {
    "styling": "Tailwind CSS",
    "routing": "None",
    "stateManagement": "React Context",
    "authentication": "None",
    "designSystem": "Custom"
  },
  "tooling": {
    "linting": "ESLint",
    "formatting": "Prettier",
    "testing": "None"
  },
  "environmentVariables": [],
  "scripts": {},
  "dependencies": [
    {
      "name": "lucide-react",
      "isDev": false,
      "reason": "Icons for UI"
    }
  ],
  "fileStructure": [
    {
      "path": "src/ExpenseContext.tsx",
      "purpose": "Provide global state for transactions and category filtering.",
      "type": "file",
      "complexity": "medium",
      "responsibilities": [
        "Own transaction state",
        "Maintain filter state",
        "Calculate balance"
      ]
    },
    {
      "path": "src/TransactionList.tsx",
      "purpose": "Display filtered transactions and handle deletion.",
      "type": "file",
      "complexity": "medium",
      "responsibilities": [
        "Display list of transactions",
        "Trigger transaction deletion"
      ]
    },
    {
      "path": "src/AddTransactionForm.tsx",
      "purpose": "Capture new transaction details via form input.",
      "type": "file",
      "complexity": "medium",
      "responsibilities": [
        "Capture user input",
        "Validate form data",
        "Add new transaction"
      ]
    },
    {
      "path": "src/App.tsx",
      "purpose": "Root component orchestrating layout and state context.",
      "type": "file",
      "complexity": "low",
      "responsibilities": [
        "Layout shell",
        "Provide ExpenseContext"
      ]
    }
  ],
  "componentContracts": [
    {
      "name": "ExpenseContext",
      "description": "State management for transactions.",
      "exportType": "named",
      "exports": [
        "ExpenseProvider",
        "useExpense"
      ],
      "props": [],
      "publicAPI": {
        "exports": {}
      }
    },
    {
      "name": "TransactionList",
      "description": "Displays list of transactions.",
      "exportType": "default",
      "exports": [
        "TransactionList"
      ],
      "props": []
    },
    {
      "name": "AddTransactionForm",
      "description": "Form to add items.",
      "exportType": "default",
      "exports": [
        "AddTransactionForm"
      ],
      "props": []
    }
  ],
  "behavioralContracts": [
    {
      "file": "src/ExpenseContext.tsx",
      "responsibilities": [
        "Maintain transaction list",
        "Filter transactions by category",
        "Derive balance"
      ],
      "behaviorRules": [
        {
          "trigger": "Add transaction",
          "preconditions": [
            "Input fields are valid"
          ],
          "action": "Append transaction to state",
          "assertions": [
            "Balance updates",
            "List updates"
          ]
        },
        {
          "trigger": "Delete transaction",
          "preconditions": [
            "Transaction exists"
          ],
          "action": "Remove transaction from state",
          "assertions": [
            "Balance updates",
            "Transaction removed from UI"
          ]
        }
      ],
      "acceptanceCriteria": [
        "Balance reflects sum of income and expenses",
        "Transactions can be filtered by category",
        "Transactions can be deleted"
      ]
    },
    {
      "file": "src/TransactionList.tsx",
      "responsibilities": [
        "Render transaction list",
        "Execute delete action"
      ],
      "behaviorRules": [
        {
          "trigger": "Click delete button",
          "preconditions": [
            "Transaction exists"
          ],
          "action": "Call deleteTransaction",
          "assertions": [
            "List updates"
          ]
        }
      ],
      "acceptanceCriteria": [
        "List renders all transactions",
        "Delete button removes item"
      ]
    },
    {
      "file": "src/AddTransactionForm.tsx",
      "responsibilities": [
        "Handle form submission"
      ],
      "behaviorRules": [
        {
          "trigger": "Submit form",
          "preconditions": [
            "Amount is non-zero",
            "Category is selected"
          ],
          "action": "Call addTransaction",
          "assertions": [
            "Form is cleared",
            "List updates"
          ]
        }
      ],
      "acceptanceCriteria": [
        "Form adds new transaction to list",
        "Form resets after submission"
      ]
    }
  ],
  "buildConfiguration": {
    "outputDirectory": "dist"
  }
}